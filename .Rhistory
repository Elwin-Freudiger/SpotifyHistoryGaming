poop <-  c(1,2,3)
batch_ids <- function(ids, size = 50) {
split(ids, ceiling(seq_along(ids) / size))
}
batch_ids(poop, 1)
batch_ids(poop, 2)
poopy <- batch_ids(poop, 2)
length(poopy)
poopy$1
poopy[1]
poopy[2]
